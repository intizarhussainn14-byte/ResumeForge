generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResumeStatus {
  DRAFT
  ANALYZED
  OPTIMIZED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  password   String
  role       UserRole @default(USER)
  isVerified Boolean  @default(false)

  resumes Resume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resume {
  id            String       @id @default(cuid())
  title         String
  originalText  String
  optimizedText String?
  atsScore      Int?
  status        ResumeStatus @default(DRAFT)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  analyses        Analysis[]
  jobDescriptions JobDescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobDescription {
  id      String  @id @default(cuid())
  title   String?
  company String?
  content String

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Analysis {
  id              String @id @default(cuid())
  overallScore    Int
  keywordScore    Int
  skillsScore     Int
  formattingScore Int

  missingKeywords Json
  strengths       Json
  weaknesses      Json
  suggestions     Json

  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
